# ===== 应用 =====
APP_NAME=My Private Assistant
APP_ENV=local
DEBUG=true
HOST=127.0.0.1
PORT=8000
TIMEZONE=Asia/Shanghai

# ===== 数据库（SQLite，默认存 data/assistant.db，禁止提交） =====
DATABASE_URL=sqlite:///./data/assistant.db

# ===== DeepSeek（OpenAI 兼容接口） =====
# 申请地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# ===== Zotero（科研板块，可选） =====
ZOTERO_API_KEY=
ZOTERO_USER_ID=
ZOTERO_LIBRARY_TYPE=user
ZOTERO_LOCAL_API_URL=http://127.0.0.1:23119/api

# ===== 定时任务 =====
ENABLE_SCHEDULER=true
# 每日 arXiv 论文抓取时间（24 小时制）
ARXIV_FETCH_HOUR=8
ARXIV_FETCH_MINUTE=5
# 每日 RSS 资讯聚合时间
RSS_FETCH_HOUR=8
RSS_FETCH_MINUTE=40
ARXIV_CATEGORIES=cs.AI
ARXIV_MAX_RESULTS=20
RSS_FEEDS=https://arxiv.org/rss/cs.AI,https://huggingface.co/blog/feed.xml,https://hnrss.org/frontpage

# ===== MCP =====
# 本地开发：stdio；线上部署：sse
MCP_MODE=stdio

# ===== 首次启动写入演示数据，稳定后设为 false =====
SEED_DEMO_DATA=true
